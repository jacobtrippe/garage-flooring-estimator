generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id         String     @id @default(cuid())
  name       String
  phone      String
  email      String
  street     String
  city       String
  state      String
  zip        String
  garageSqft Float
  carPorts   Int
  notes      String     @default("")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  estimates  Estimate[]
}

model Estimate {
  id                         String         @id @default(cuid())
  customerId                 String
  totalPrice                 Float
  status                     String         @default("draft")
  signatureDataUrl           String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  pdfUrl                     String?
  installationDate           String?
  exteriorSqft               Float?
  quoteType                  String         @default("interior")
  approvedDiscount           Float          @default(0)
  contractorSignatureDataUrl String?
  signatureToken             String?        @unique
  signatureTokenExpiresAt    DateTime?
  customerSignedAt           DateTime?
  agreementPdfUrl            String?
  estimatePdfUrl             String?
  jobPhotoUrl                String?
  customer                   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items                      EstimateItem[]
}

model EstimateItem {
  id         String   @id @default(cuid())
  estimateId String
  productId  String
  price      Float
  name       String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Section {
  id           String    @id @default(cuid())
  title        String
  displayOrder Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  category     String    @default("interior")
  products     Product[]
}

model Product {
  id            String         @id @default(cuid())
  sectionId     String
  name          String
  pricingType   String
  price         Float
  isActive      Boolean        @default(true)
  displayOrder  Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  estimateItems EstimateItem[]
  section       Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model PlatinumInquiry {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  phone          String
  projectType    String
  garageSize     String
  coatingSystem  String?
  projectDetails String?
  address        String?
  createdAt      DateTime @default(now())
}
